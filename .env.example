# Copy to .env and fill in. .env is gitignored; never commit real values.

# --- Backends -------------------------------------------------------------
# fake = fully offline demo/test mode (no Google, no Anthropic account needed)
CWOPS_DRIVE_BACKEND=fake
CWOPS_AI_BACKEND=fake

# --- Safety ---------------------------------------------------------------
# Master switch. Even when true, every mutation still requires a human
# approval record created out-of-band via `cwops approve <proposal_id>`.
CWOPS_ALLOW_MUTATIONS=false

# App-owned workspace folder. Every operation must target a descendant of it.
# Created by `cwops workspace init`. Required whenever ALLOW_MUTATIONS=true.
CWOPS_ROOT_FOLDER_ID=

# --- Google OAuth (least privilege) ---------------------------------------
# Scope is hard-coded to https://www.googleapis.com/auth/drive.file.
# That is Google's only non-sensitive Drive scope: per-file access to files
# this app created or that the user explicitly opened/shared with it.
CWOPS_GOOGLE_CLIENT_SECRETS=client_secret.json
CWOPS_TOKEN_PATH=.cwops/token.json

# --- Claude ---------------------------------------------------------------
# The Anthropic SDK reads ANTHROPIC_API_KEY from the environment directly.
ANTHROPIC_API_KEY=
CWOPS_CLAUDE_MODEL=claude-opus-5
CWOPS_CLAUDE_EFFORT=low

# --- Limits / storage -----------------------------------------------------
CWOPS_DB_PATH=cwops.db
CWOPS_MAX_FILES_PER_PROPOSAL=50
CWOPS_MAX_FILE_CHARS=20000
CWOPS_APPROVAL_TTL_SECONDS=900
CWOPS_LOG_LEVEL=INFO
